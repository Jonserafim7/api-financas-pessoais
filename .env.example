# Database Configuration
# PostgreSQL credentials (used by the database container)
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=controle-financas-db

# PostgreSQL connection string for the API
# For containers: host = db (docker-compose service name)
# For local host Postgres, change host to localhost
DATABASE_URL=postgresql://docker:docker@db:5432/controle-financas-db?schema=public

# Better Auth Configuration
# Secret key for signing Better Auth tokens (generate random string in production)
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET="your_secret_key_here_generate_random_in_production"

# Base URL of your application (used for auth redirects and CORS)
BETTER_AUTH_URL="http://localhost:3000"

# Server Configuration
# Port where API server listens (default: 3000)
PORT=3000

# Frontend Configuration
# URL onde o frontend acessa a API
VITE_API_URL=http://localhost:3000
