# Database Configuration
# PostgreSQL connection string (format: postgresql://user:password@host:port/database)
# For local development: postgresql://user:password@localhost:5432/financas_db?schema=public
# For Docker: postgresql://docker:docker@controle-financas-pg:5432/controle-financas-db?schema=public
DATABASE_URL="postgresql://docker:docker@localhost:5432/controle-financas-db?schema=public"

# Better Auth Configuration
# Secret key for signing Better Auth tokens (generate random string in production)
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET="your_secret_key_here_generate_random_in_production"

# Base URL of your application (used for auth redirects and CORS)
BETTER_AUTH_URL="http://localhost:3000"

# Server Configuration
# Port where API server listens (default: 3000)
PORT=3000

# Google OAuth Configuration (optional - for Google login)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
